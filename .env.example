# Host folder with the Markdown vault (source of truth). Windows example: D:/umm/vault
UMM_VAULT_PATH=./vault
# File with the bearer token (one line, >= 32 chars). Windows example: D:/umm/secrets/memory_api_token
UMM_TOKEN_FILE=./secrets/memory_api_token
# Published port and bind address on the host.
# 127.0.0.1 keeps the API off the LAN. Set UMM_BIND=0.0.0.0 to publish it.
# A published port still requires the bearer token. curl from a LAN IP works.
# Browser Origin must be localhost unless http.allowed_origins lists the name.
# Set http.allowed_hosts to also restrict Host. MEMORY_HTTP_ALLOW_ANY_HOST=1 turns both checks off.
UMM_PORT=27123
UMM_BIND=127.0.0.1
UMM_IMAGE_TAG=local
