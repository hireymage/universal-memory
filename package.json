{
  "name": "universal-memory-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vendor-agnostic long-term memory MCP server with Markdown as source of truth",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "universal-memory-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts vitest.config.ts eslint.config.js",
    "measure:tools": "tsx scripts/measure-tools.ts",
    "start": "node dist/cli.js serve",
    "dev": "tsx src/cli.ts serve"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "commander": "^14.0.0",
    "diff": "^8.0.2",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "pino": "^9.7.0",
    "ulid": "^3.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "eslint": "^9.33.0",
    "js-tiktoken": "^1.0.21",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@hono/node-server": "2.1.0"
  }
}
